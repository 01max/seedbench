#!/bin/sh
set -eu
cd "$(dirname "$0")/../.."
project="seedbench-check-$(date +%s)-$$"
temporary=$(mktemp -d "${TMPDIR:-/tmp}/seedbench-check.XXXXXX")
export SEEDBENCH_STATE_ROOT=/state SEEDBENCH_SCRATCH_ROOT=/scratch SEEDBENCH_PAYLOAD_ROOT=/payloads
export SEEDBENCH_UID=1000 SEEDBENCH_GID=1000
binds=false
if [ "${1:-}" = --binds ]; then
  binds=true
  export SEEDBENCH_STATE_ROOT='/unusual state' SEEDBENCH_SCRATCH_ROOT='/analysis scratch' SEEDBENCH_PAYLOAD_ROOT='/library books'
  export SEEDBENCH_STATE_SOURCE="$temporary/state folder" SEEDBENCH_SCRATCH_SOURCE="$temporary/scratch folder" SEEDBENCH_PAYLOAD_SOURCE="$temporary/payload folder"
  mkdir "$SEEDBENCH_STATE_SOURCE" "$SEEDBENCH_SCRATCH_SOURCE" "$SEEDBENCH_PAYLOAD_SOURCE"
  chmod 777 "$SEEDBENCH_STATE_SOURCE" "$SEEDBENCH_SCRATCH_SOURCE" "$SEEDBENCH_PAYLOAD_SOURCE"
elif [ "${1:-}" = --named-overrides ]; then
  export SEEDBENCH_STATE_ROOT='/alternate state' SEEDBENCH_SCRATCH_ROOT='/alternate scratch' SEEDBENCH_PAYLOAD_ROOT='/alternate payloads'
  export SEEDBENCH_UID=65534 SEEDBENCH_GID=65534
fi
compose() {
  if [ "$binds" = true ]; then
    docker compose --env-file config/compose.defaults.env -p "$project" -f compose.yaml -f compose.smoke.yaml -f compose.binds.yaml "$@"
  else
    docker compose --env-file config/compose.defaults.env -p "$project" -f compose.yaml -f compose.smoke.yaml "$@"
  fi
}
cleanup_bind_folders() {
  compose stop
  compose run --rm --no-deps -T --entrypoint ruby web -rfileutils -e '
    abort "Use only disposable runtime fixtures" unless ENV["SEEDBENCH_RUNTIME_VERIFICATION"] == "1"
    %w[SEEDBENCH_STATE_ROOT SEEDBENCH_SCRATCH_ROOT SEEDBENCH_PAYLOAD_ROOT].each do |key|
      root = ENV.fetch(key)
      Dir.children(root).each { |name| FileUtils.remove_entry(File.join(root, name)) }
    end
  '
}
cleanup() {
  status=$?
  trap - EXIT INT TERM
  if [ "$status" -ne 0 ]; then compose logs --no-color --tail 40; fi
  if [ "$binds" = true ]; then
    cleanup_bind_folders || status=1
  fi
  compose down --volumes --remove-orphans
  rm -rf "$temporary"
  exit "$status"
}
trap cleanup EXIT INT TERM
compose build web
compose run --rm --no-deps web bin/rails db:prepare db:migrate
compose up -d --no-build --wait
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/prepare_runtime.rb
compose stop worker
compose rm -f worker
if compose exec -T web bin/container-entrypoint bin/rails runner script/quality/interrupt_dispatch.rb; then
  exit 1
else
  status=$?
  [ "$status" -eq 29 ] || exit "$status"
fi
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/runtime_workflows.rb verify_gap
compose up -d --no-build --no-deps worker
wait_for_sql() {
  query=$1
  database=${2:-production.sqlite3}
  remaining=60
  until compose exec -T web sh -c 'test "$(sqlite3 -readonly "$SEEDBENCH_STATE_ROOT/$2" "$1")" = 1' sh "$query" "$database" >/dev/null 2>&1; do
    remaining=$((remaining - 1))
    [ "$remaining" -gt 0 ] || exit 1
    sleep 1
  done
}
wait_for_sql "SELECT COUNT(*) FROM workflow_operations WHERE request_key = 'interrupted-dispatch' AND state = 'succeeded'"
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/runtime_workflows.rb queue_duplicates
wait_for_sql "SELECT COUNT(*) = 0 FROM solid_queue_jobs WHERE class_name = 'WorkflowOperationJob' AND finished_at IS NULL" production_queue.sqlite3
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/runtime_workflows.rb start_stale
wait_for_sql "SELECT COUNT(*) FROM workflow_operations WHERE request_key = 'stale-compute' AND state = 'running'"
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/runtime_workflows.rb release_stale
wait_for_sql "SELECT COUNT(*) FROM workflow_operations WHERE request_key = 'stale-compute' AND state = 'stale'"
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/runtime_workflows.rb start_crash
wait_for_sql "SELECT COUNT(*) FROM workflow_operations WHERE request_key = 'interrupted-compute' AND state = 'running'"
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/runtime_workflows.rb checkpoint_crash
compose kill -s SIGKILL worker
compose rm -f worker
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/runtime_workflows.rb recover_crash
compose up -d --no-build --no-deps worker
wait_for_sql "SELECT COUNT(*) FROM workflow_operations WHERE request_key = 'interrupted-compute' AND state = 'succeeded'"
compose up -d --no-build --no-deps --force-recreate --wait web
compose exec -T web bin/container-entrypoint bin/rails runner script/quality/check_runtime.rb
