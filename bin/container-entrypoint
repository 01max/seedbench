#!/usr/bin/env ruby
require "securerandom"
require "fileutils"

File.umask(0o077)
FileUtils.mkdir_p(%w[/tmp/rails-home /tmp/rails-tmp /tmp/rails-log])
%w[SEEDBENCH_STATE_ROOT SEEDBENCH_SCRATCH_ROOT SEEDBENCH_PAYLOAD_ROOT].each do |name|
  path = ENV.fetch(name)
  abort "#{name} must be an existing writable absolute directory" unless
    path.start_with?("/") && File.directory?(path) && File.writable?(path)
end

restore_marker = File.join(ENV.fetch('SEEDBENCH_STATE_ROOT'), '.seedbench-restored')
if ARGV.take(2) == %w[bin/rails server] && (File.exist?(restore_marker) || File.symlink?(restore_marker))
  abort 'Restored state requires reconciliation. See the deployment recovery guide.'
end

ENV["TMPDIR"] ||= File.join(ENV.fetch("SEEDBENCH_SCRATCH_ROOT"), "request-uploads")
FileUtils.mkdir_p(ENV.fetch("TMPDIR"), mode: 0o700)
abort "TMPDIR must be an existing writable absolute directory without a symlink" unless
  ENV.fetch("TMPDIR").start_with?("/") && File.directory?(ENV.fetch("TMPDIR")) &&
    !File.symlink?(ENV.fetch("TMPDIR")) && File.writable?(ENV.fetch("TMPDIR"))

if ENV["SECRET_KEY_BASE"].to_s.empty? && !ENV["SECRET_KEY_BASE_DUMMY"]
  key_path = File.join(ENV.fetch("SEEDBENCH_STATE_ROOT"), "secret_key_base")
  File.open(key_path, File::RDWR | File::CREAT | File::NOFOLLOW, 0o600) do |file|
    file.flock(File::LOCK_EX)
    key = file.read.strip
    if key.empty?
      key = SecureRandom.hex(64)
      file.rewind
      file.write(key)
      file.fsync
    end
    ENV["SECRET_KEY_BASE"] = key
  end
end

if ENV["SEEDBENCH_ENCRYPTION_KEY"].to_s.empty?
  key_path = File.join(ENV.fetch("SEEDBENCH_STATE_ROOT"), "provider_encryption_key")
  File.open(key_path, File::RDWR | File::CREAT | File::NOFOLLOW, 0o600) do |file|
    file.flock(File::LOCK_EX)
    key = file.read.strip
    if key.empty?
      key = SecureRandom.hex(32)
      file.rewind
      file.write(key)
      file.fsync
    end
    ENV["SEEDBENCH_ENCRYPTION_KEY"] = key
  end
end
abort "Provider encryption key must be 64 hexadecimal characters" unless ENV["SEEDBENCH_ENCRYPTION_KEY"].match?(/\A[0-9a-fA-F]{64}\z/)

exec(*ARGV)
