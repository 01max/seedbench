<section class="settings-panel" id="defaults" aria-labelledby="defaults-title">
  <header>
    <h2 id="defaults-title"><%= t('settings.defaults.title') %></h2>
    <p><%= t('settings.defaults.hint') %></p>
  </header>
  <%= form_with url: settings_path, method: :patch, scope: :defaults, class: 'settings-body settings-form' do |form| %>
    <%= form.hidden_field :expected_revision, value: @defaults.revision %>
    <label class="settings-checkbox">
      <%= form.check_box :automatic_ai, checked: @defaults.automatic_ai %>
      <span><%= render 'shared/ai_icon' %> <%= t('settings.defaults.automatic_ai') %></span>
    </label>
    <div class="settings-fields">
      <% Providers::Catalog::ROLES.each do |role, definition| %>
        <div class="settings-field">
          <%= label_tag "default_#{role}", t('settings.defaults.provider', role: t("settings.roles.#{role}"), provider: definition.name) %>
          <%= select_tag "defaults[connection_ids][#{role}]",
                options_for_select(@connections.fetch(role, []).map { |connection| [connection.label, connection.id] }, @defaults.connection_ids[role]),
                include_blank: t('settings.defaults.unconfigured'), id: "default_#{role}" %>
        </div>
      <% end %>
    </div>
    <%= form.submit t('settings.defaults.save'), class: 'work-button primary' %>
  <% end %>
</section>
