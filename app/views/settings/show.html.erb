<main class="mx-auto max-w-5xl px-6 py-8">
  <h1 class="text-2xl font-bold">Réglages</h1>
  <p class="mt-2">Les tests indiquent leur portée réelle. Aucun test ne publie, ne démarre un torrent ou n’envoie une image.</p>
  <section class="mt-6 rounded border p-5" aria-labelledby="defaults-title">
    <h2 id="defaults-title" class="text-lg font-semibold">Choix pour les prochains livres</h2>
    <p class="mt-2 text-sm">Ces choix ne modifient pas les livres existants et ne lancent ni n’annulent aucune opération.</p>
    <%= form_with url: settings_path, method: :patch, scope: :defaults, class: "mt-4 grid gap-3" do |form| %>
      <%= form.hidden_field :expected_revision, value: @defaults.revision %>
      <label><%= form.check_box :automatic_ai, checked: @defaults.automatic_ai %> Premier passage IA automatique</label>
      <% Providers::Catalog::ROLES.each do |role, definition| %>
        <%= label_tag "default_#{role}", "#{definition.title} · #{definition.name}" %>
        <%= select_tag "defaults[connection_ids][#{role}]", options_for_select(@connections.fetch(role, []).map { |connection| [ connection.label, connection.id ] }, @defaults.connection_ids[role]), include_blank: "Non configuré", id: "default_#{role}", class: "rounded border p-2" %>
      <% end %>
      <%= form.submit "Enregistrer les choix par défaut", class: "justify-self-start rounded border px-3 py-2" %>
    <% end %>
  </section>
  <% Providers::Catalog::ROLES.each do |role, definition| %>
    <section class="mt-6 rounded border p-5" aria-labelledby="role-<%= role %>">
      <h2 id="role-<%= role %>" class="text-lg font-semibold"><%= definition.title %> · <%= definition.name %></h2>
      <% @connections.fetch(role, []).each do |connection| %>
        <article class="mt-4 border-t pt-4" aria-label="<%= connection.label %>">
          <h3 class="font-semibold"><%= connection.label %></h3>
          <p class="text-sm"><%= connection.endpoint %> · Identité : <%= connection.identity_key %></p>
          <p>Secret : <%= connection.credentials.present? ? "•••••••• (configuré)" : "non configuré" %></p>
          <% if connection.options["model"] %><p>Modèle : <%= connection.options["model"] %></p><% end %>
          <% if role == "ai" %>
            <%= form_with url: configure_provider_connection_path(connection), method: :patch, scope: :configuration, namespace: "configure_#{connection.id}", class: "my-3 flex flex-wrap items-center gap-2" do |form| %>
              <%= form.hidden_field :expected_version, value: connection.credentials_version %>
              <%= form.fields_for :options do |fields| %>
                <%= fields.label :model, "Modèle à utiliser" %><%= fields.text_field :model, value: connection.options["model"], required: true, class: "rounded border p-2" %>
              <% end %>
              <%= form.submit "Enregistrer le modèle", class: "rounded border px-3 py-2" %>
            <% end %>
          <% end %>
          <p>Test : <%= { "untested" => "non effectué", "passed" => "réussi", "limited" => "portée limitée", "failed" => "échec" }.fetch(connection.check_status) %></p>
          <% if connection.checked_at %><p class="text-sm"><%= connection.checked_at.utc.iso8601 %> · <%= connection.check_message %></p><% end %>
          <%= button_to "Tester #{connection.label}", check_provider_connection_path(connection), class: "mt-2 underline" %>
          <details class="mt-3">
            <summary class="cursor-pointer">Remplacer le secret de la même identité</summary>
            <p class="mt-2 text-sm">Pour un autre compte, démon ou endpoint, créez une nouvelle connexion et affectez-la explicitement aux livres concernés.</p>
            <%= form_with url: rotate_provider_connection_path(connection), method: :patch, scope: :rotation, namespace: "rotate_#{connection.id}", class: "mt-3 grid gap-2" do |form| %>
              <%= form.hidden_field :expected_version, value: connection.credentials_version %>
              <%= form.fields_for :credentials do |fields| %>
                <%= fields.label definition.secret, "Nouveau secret" %>
                <%= fields.password_field definition.secret, required: true, autocomplete: "new-password", class: "rounded border p-2" %>
              <% end %>
              <label><%= form.check_box :confirm_identity, required: true %> Je confirme la même identité de compte ou de démon.</label>
              <%= form.submit "Remplacer le secret", class: "justify-self-start rounded border px-3 py-2" %>
            <% end %>
          </details>
        </article>
      <% end %>
      <details class="mt-4">
        <summary class="cursor-pointer">Ajouter une connexion <%= definition.name %></summary>
        <%= form_with url: provider_connections_path, scope: :connection, namespace: role, class: "mt-3 grid gap-2" do |form| %>
          <%= form.hidden_field :role, value: role %>
          <%= form.label :label, "Libellé" %><%= form.text_field :label, required: true, maxlength: 120, class: "rounded border p-2" %>
          <%= form.label :identity_key, role == "torrent_client" ? "Identifiant du démon Deluge" : "Identité stable du compte ou projet" %>
          <%= form.text_field :identity_key, required: true, maxlength: 120, class: "rounded border p-2" %>
          <% if role == "torrent_client" %>
            <%= form.label :endpoint, "Adresse du WebUI Deluge (sans /json)" %><%= form.url_field :endpoint, required: true, class: "rounded border p-2" %>
          <% end %>
          <%= form.fields_for :credentials do |fields| %>
            <%= fields.label definition.secret, definition.secret == "password" ? "Mot de passe WebUI" : "Clé API" %>
            <%= fields.password_field definition.secret, required: true, autocomplete: "new-password", class: "rounded border p-2" %>
          <% end %>
          <% if role == "ai" %>
            <%= form.fields_for :options do |fields| %>
              <%= fields.label :model, "Identifiant exact du modèle" %><%= fields.text_field :model, required: true, class: "rounded border p-2" %>
            <% end %>
          <% end %>
          <% if role == "image_host" %><p class="text-sm">Le test ne vérifie pas la clé et n’effectue aucun envoi.</p><% end %>
          <%= form.submit "Enregistrer la connexion", class: "justify-self-start rounded border px-3 py-2" %>
        <% end %>
      </details>
    </section>
  <% end %>
</main>
