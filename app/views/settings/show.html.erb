<% content_for :title, t('settings.title') %>
<main class="settings-page">
  <header class="settings-header">
    <h1><%= t('settings.title') %></h1>
    <p><%= t('settings.intro') %></p>
  </header>
  <div class="settings-layout">
    <nav class="settings-sidebar" aria-label="<%= t('settings.sections') %>">
      <%= link_to t('settings.defaults.navigation'), '#defaults' %>
      <% Providers::Catalog::ROLES.each_value do |definition| %>
        <%= link_to definition.name, "#provider-#{definition.provider}" %>
      <% end %>
    </nav>
    <div class="settings-sections">
      <%= render 'defaults' %>
      <% Providers::Catalog::ROLES.each do |role, definition| %>
        <% connections = @connections.fetch(role, []) %>
        <section class="settings-panel" id="provider-<%= definition.provider %>" aria-labelledby="role-<%= role %>">
          <header>
            <h2 id="role-<%= role %>"><%= definition.name %></h2>
            <p><%= t("settings.roles.#{role}") %></p>
          </header>
          <%= render partial: 'connection', collection: connections, locals: { role: role, definition: definition } %>
          <div class="settings-body">
            <% if connections.empty? %><p class="settings-hint"><%= t('settings.connection.empty') %></p><% end %>
            <%= render 'new_connection', role: role, definition: definition %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</main>
