<% content_for :title, t('settings.title') %>
<main class="settings-page">
  <header class="settings-header">
    <div class="settings-heading">
      <h1><%= t('settings.title') %></h1>
      <%= link_to t('settings.back'), root_path, class: 'work-button' %>
    </div>
  </header>
  <div class="settings-layout">
    <nav class="settings-sidebar" aria-label="<%= t('settings.sections') %>">
      <%= link_to t('settings.defaults.navigation'), settings_path, aria: { current: ('page' unless @role) } %>
      <% Providers::Catalog::ROLES.each_key do |role| %>
        <%= link_to settings_provider_path(role), aria: { current: ('page' if @role == role) } do %>
          <%= render 'shared/ai_icon' if role == 'ai' %>
          <%= t("settings.roles.#{role}") %>
        <% end %>
      <% end %>
    </nav>
    <div class="settings-sections">
      <% if @role %>
        <%= render 'provider', role: @role, definitions: @definitions, selected_provider: @selected_provider, connections: @provider_connections %>
      <% else %>
        <%= render 'defaults' %>
      <% end %>
    </div>
  </div>
</main>
