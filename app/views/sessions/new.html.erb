<main class="mx-auto max-w-md px-6 py-20">
  <p class="text-sm font-semibold uppercase tracking-widest text-[var(--accent)]"><%= t("application.name") %></p>
  <h1 class="mt-4 text-2xl font-bold"><%= t("workbench.login.title") %></h1>
  <p class="mt-3"><%= t("workbench.login.intro") %></p>
  <%= form_with url: operator_session_path, scope: :operator, class: "mt-6 grid gap-4" do |form| %>
    <%= form.label :password, t("workbench.login.password") %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", autofocus: true, class: "rounded border p-2" %>
    <%= form.submit t("workbench.login.submit"), class: "rounded bg-[var(--accent)] px-4 py-2 text-[var(--on-accent)]" %>
  <% end %>
</main>
