<%= turbo_frame_tag dom_id(@release, :status), data: { controller: "checklist", status_poll_target: "frame" } do %>
  <div class="status-content" data-status-sequence="<%= @snapshot.events.first&.sequence || 0 %>" data-active-operations="<%= @workflow_active || false %>">
  <% preparation_operation = @snapshot.operations.find { |operation| operation.kind == "preparation" && operation.state == "succeeded" && operation.result["preparation_id"] == @snapshot.preparation&.id } %>
  <span hidden data-preparation-state="<%= @release.preparation_state %>" data-has-preparation="<%= @snapshot.preparation.present? %>" data-preparation-approved-revision="<%= preparation_operation&.input_revision %>" data-preparation-completed-revision="<%= preparation_operation&.input_revision&.+(1) %>" data-preparation-observed-revision="<%= @release.input_revision %>"></span>
  <% if @check_error %>
    <p role="alert" class="work-alert"><%= @check_error %></p>
    <%= link_to t("releases.reload_saved"), release_path(@release), class: "work-button", data: { turbo_frame: "_top" } %>
  <% end %>
  <% @checklist.each do |item| %>
    <div class="check-row" data-check-key="<%= item.key %>" data-check-state="<%= item.state %>" data-uncertain="<%= item.finding.present? %>">
      <div><span class="check-name"><span class="check-symbol" aria-hidden="true"><%= (item.finding && !item.checked) ? "!" : {"done" => "✓", "blocked" => "!", "pending" => "○", "optional" => "—"}.fetch(item.state) %></span><span><%= item.label %></span></span><small><%= t("workbench.checklist.owners.#{item.owner}") %></small></div>
      <p><span class="<%= "sr-only" if item.required %>"><%= t("workbench.status.#{item.required ? 'required' : 'optional'}") %></span><%= item.note %></p>
      <% if item.owner == :operator %>
        <%= form_with url: release_checks_path(@release), scope: :mark, data: { turbo_frame: dom_id(@release, :status) }, class: "manual-check-form" do |form| %>
          <%= form.hidden_field :key, value: item.key %>
          <%= form.hidden_field :expected_revision, value: @release.input_revision %>
          <% if item.finding %><%= form.hidden_field :finding_id, value: item.finding.id %><%= form.hidden_field :number, value: item.finding.number %><% end %>
          <label><%= form.check_box :checked, checked: item.checked, id: "mark-#{item.key}", data: { action: "change->checklist#submit" } %> <%= item.finding ? t("workbench.status.accept") : item.label %></label>
          <%= form.submit t("workbench.status.apply"), class: "work-button quiet" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% @snapshot.findings.select { |finding| finding.severity == "failure" }.each do |finding| %><p class="work-warning"><%= finding.message %></p><% end %>
  <details class="status-dimensions" data-detail-key="dimensions"><summary><%= t("workbench.status.dimensions") %></summary>
    <% { "inspection" => @release.inspection_state, "preparation" => @release.preparation_state, "draft" => @release.draft_state, "publication" => @release.publication_state, "seeding" => @release.seeding_state }.each do |key, state| %><p><%= t("workbench.status.dimension", label: t("workbench.checklist.#{key}.label"), state: workflow_label(state)) %></p><% end %>
  </details>
  <% if @release.publication_state == "published" && @release.draft_link && !@snapshot.snapshots["draft"]&.remote_deleted %><p role="alert" class="work-alert"><%= t("drafts.leftover") %></p><% end %>
  <% @snapshot.snapshots.each do |kind, snapshot| %><p class="remote-identity"><%= t("workbench.status.remote", kind: t("workbench.status.#{kind == 'draft' ? 'draft' : 'submission'}"), id: snapshot.remote_id) %><%= t("workbench.status.absent") if snapshot.remote_deleted %></p><% end %>
  <% @snapshot.operations.each do |operation| %>
    <details class="operation-state" data-detail-key="operation_<%= operation.id %>">
      <summary><%= t("workbench.status.operation", id: operation.id, state: workflow_label(operation.state)) %></summary>
      <p><%= t("workbench.status.phase", phase: operation_phase_label(operation.phase)) %></p>
      <% if operation.kind == "preparation" && (operation.result["error_code"] || operation.error_code) %><p class="work-warning"><%= t("preparation.errors.#{operation.result['error_code'] || operation.error_code}", default: t("preparation.errors.operation_expired")) %></p><% end %>
      <% if operation.error_code %><p><%= t("workbench.status.diagnostic", code: operation.error_code) %></p><% end %>
      <% if operation.external_reference.present? %><p><%= t("workbench.status.external_identity") %></p><pre><%= JSON.pretty_generate(operation.external_reference) %></pre><% end %>
    </details>
  <% end %>
  </div>
<% end %>
