<aside class="release-checklist" aria-label="<%= t("workbench.status.label") %>" data-controller="status-poll"
       data-status-poll-messages-value="<%= t("workbench.status.messages").to_json %>"
       data-status-poll-url-value="<%= release_status_path(@release) %>"
       data-action="turbo:frame-load->status-poll#loaded turbo:before-frame-render->status-poll#preserveNewer turbo:submit-start->status-poll#pause turbo:submit-end->status-poll#resume turbo:frame-missing->status-poll#failed turbo:fetch-request-error->status-poll#failed visibilitychange@document->status-poll#visibility evidence:updated@document->status-poll#refresh">
  <div class="checklist-heading"><h2><%= t("workbench.status.title") %></h2><button type="button" class="work-button quiet" aria-label="<%= t("workbench.status.refresh") %>" data-action="status-poll#refresh">↻</button></div>
  <p class="checklist-legend"><%= t("workbench.status.legend") %></p>
  <p class="refresh-state" role="status" data-status-poll-target="message"><%= t("workbench.status.messages.current") %></p>
  <%= render "status" %>
  <section class="release-activity"><h2><%= t("workbench.status.activity") %></h2><% @snapshot.events.first(3).each do |event| %><p><%= l(event.occurred_at, format: :short) %><br><%= event_label(event.name) %></p><% end %></section>
</aside>
