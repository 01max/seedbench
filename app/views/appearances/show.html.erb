<%= turbo_frame_tag "appearance" do %>
  <section aria-label="Apparence" class="mt-8">
    <h2 class="mb-3 text-lg font-semibold">Apparence</h2>
    <button type="button" role="switch" aria-checked="false"
            data-appearance-target="toggle" data-action="appearance#toggle"
            class="rounded border border-current px-4 py-2">
      Mode sombre
    </button>
  </section>
<% end %>
