<%= turbo_frame_tag "appearance" do %>
  <section aria-label="<%= t("workbench.navigation.appearance") %>" class="mt-8">
    <h2 class="mb-3 text-lg font-semibold"><%= t("workbench.navigation.appearance") %></h2>
    <button type="button" role="switch" aria-checked="false"
            data-appearance-target="toggle" data-action="appearance#toggle"
            class="rounded border border-current px-4 py-2">
      <%= t("workbench.navigation.dark_mode") %>
    </button>
  </section>
<% end %>
