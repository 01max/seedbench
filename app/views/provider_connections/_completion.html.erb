<details class="settings-disclosure">
  <summary><%= t('settings.connection.complete_title') %></summary>
  <p class="settings-hint"><%= t('settings.connection.complete_hint') %></p>
  <%= form_with url: complete_provider_connection_path(connection), method: :patch, scope: :completion, namespace: "complete_#{connection.id}", class: 'settings-form' do |form| %>
    <%= form.hidden_field :expected_version, value: connection.credentials_version %>
    <div class="settings-fields">
      <%= render 'provider_connections/fields', form: form, definition: definition, role: connection.role,
            endpoint_required: connection.role == 'torrent_client' && connection.endpoint.nil?, model: connection.options['model'] %>
    </div>
    <label class="settings-checkbox"><%= form.check_box :confirm_identity, required: true %> <%= t('settings.connection.confirm_identity') %></label>
    <%= form.submit t('settings.connection.complete'), class: 'work-button' %>
  <% end %>
</details>
