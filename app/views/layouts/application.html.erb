<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="dark">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag 'seedbench-logo.svg', type: 'image/svg+xml' %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-controller="appearance">
    <% if current_operator %>
      <nav aria-label="<%= t("workbench.navigation.label") %>" class="app-nav">
        <%= link_to root_path, class: 'app-brand' do %>
          <%= image_tag 'seedbench-logo.svg', size: '24', alt: '' %>
          <%= t('application.name') %>
        <% end %>
        <span class="nav-context"><%= t("workbench.navigation.context") %></span>
        <div class="app-nav-actions">
          <%= yield :toolbar %>
          <%= render 'shared/theme_toggle' %>
          <%= link_to t('workbench.navigation.settings'), settings_path, aria: { current: ('location' if controller_name == 'settings') } %>
          <%= button_to t("workbench.navigation.sign_out"), destroy_operator_session_path, method: :delete %>
        </div>
      </nav>
    <% end %>
    <%= render "shared/notifications" %>
    <%= yield %>
  </body>
</html>
