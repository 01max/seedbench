<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-controller="appearance">
    <% if current_operator %>
      <nav aria-label="Navigation principale" class="flex items-center gap-6 border-b px-6 py-3">
        <%= link_to "Seedbench", root_path, class: "font-bold" %>
        <%= link_to "Réglages", settings_path, class: "underline" %>
        <%= button_to "Se déconnecter", destroy_operator_session_path, method: :delete, class: "underline" %>
      </nav>
    <% end %>
    <% flash.each do |_name, message| %><p role="status" class="mx-auto max-w-5xl px-6 py-3"><%= message %></p><% end %>
    <%= yield %>
  </body>
</html>
