<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-controller="appearance">
    <% if current_operator %>
      <nav aria-label="Navigation principale" class="app-nav">
        <%= link_to root_path, class: "app-brand" do %><span class="brand-mark" aria-hidden="true">SB</span> Seedbench<% end %>
        <span class="nav-context">Atelier d’ebooks</span>
        <div class="app-nav-actions">
          <%= yield :toolbar %>
          <%= turbo_frame_tag "appearance" do %><%= link_to "Apparence", appearance_path %><% end %>
          <%= link_to "Réglages", settings_path %>
          <%= button_to "Se déconnecter", destroy_operator_session_path, method: :delete %>
        </div>
      </nav>
    <% end %>
    <% flash.each do |name, message| %>
      <% next if name == "upload_errors" %>
      <p role="status" class="mx-auto max-w-5xl px-6 py-3"><%= message %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
